<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.factos</groupId>
        <artifactId>factos</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>factos-app</artifactId>
    <name>factos-app</name>
    <description>Runnable Spring Boot application for Factos</description>

    <dependencies>
        <!-- Internal Modules -->
        <dependency>
            <groupId>com.factos</groupId>
            <artifactId>factos-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.factos</groupId>
            <artifactId>factos-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.factos</groupId>
            <artifactId>factos-issuer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.factos</groupId>
            <artifactId>factos-billing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.factos</groupId>
            <artifactId>factos-rendering</artifactId>
        </dependency>
        <dependency>
            <groupId>com.factos</groupId>
            <artifactId>factos-security</artifactId>
        </dependency>

        <!-- Spring Boot Web & REST Client -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Spring Boot DevTools (optional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Postgres DB driver & Flyway -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
